"short Car component description"
component GradeCar
  engine = MyCar.Engine(T_max = T_max) {^engine}
  driveline = MyCar.Driveline() {^driveline}
  tau_cmd = Dyad.RealInput() {^tau_cmd}
  v_kmh = Dyad.RealOutput() {^v_kmh}
  grade = RealInput() {^grade}
  vsensor = TranslationalComponents.Sensors.VelocitySensor() {^vsensor}
  to_kmh = BlockComponents.Math.Gain(k = 3.6) {^to_kmh}
  rot_ground = RotationalComponents.Components.Fixed() {^rot_ground}
  trans_ground = TranslationalComponents.Components.Fixed() {^trans_ground}
  body = VehicleSystemsComponents.HandsOn.GradeBody() {^body}
  parameter T_max::Torque = 150
relations
  connect(engine.tau_cmd, tau_cmd) {^id11}
  connect(engine.spline, driveline.spline) {^id12}
  connect(driveline.flange, vsensor.flange, body.flange) {^id13}
  connect(to_kmh.u, vsensor.v) {^id14}
  connect(v_kmh, to_kmh.y) {^id15}
  connect(trans_ground.flange, driveline.support_t) {^id16}
  connect(rot_ground.spline, engine.support, driveline.support_r) {^id17}
  connect(body.grade, grade) {^id18}
metadata {
