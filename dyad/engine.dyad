"short Engine component description"
component Engine
  realinput = Dyad.RealInput() {^realinput}
  spline = Dyad.Spline() {^spline}
  spline1 = Dyad.Spline() {^spline1}
  padedelay = BlockComponents.Nonlinear.PadeDelay() {^padedelay}
  firstorder = BlockComponents.Continuous.FirstOrder() {^firstorder}
  limiter = BlockComponents.Nonlinear.Limiter() {^limiter}
  torquesource = RotationalComponents.Sources.TorqueSource() {^torquesource}
  parameter T_max::Real() = 190
relations
  connect(padedelay.u, realinput) {^id8}
  connect(firstorder.u, padedelay.y) {^id9}
  connect(torquesource.spline, spline) {^id10}
  connect(torquesource.support, spline1) {^id11}
  connect(firstorder.y, limiter.u) {^id12}
  connect(limiter.y, torquesource.tau) {^id13}
metadata {
