"short MappedCarWLTCAnalysis analysis description"
analysis MappedCarWLTCTransient
  extends TransientAnalysis(stop = 1800, saveat = 1, alg = ODEAlg.Rodas5P())
  model = MappedCarWLTC()
relations
metadata {
  "Dyad": {
    "experiments": {},
    "tests": {},
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 1100,
        "rot": 0,
        "layer": "icon",
        "attrs": {}
      }
    ],
    "icons": {"default": "dyad://Dyad/Default.svg"},
    "path": {},
    "doc": {"behavior": true},
    "deprecated": null,
    "panel": {}
  }
}
end