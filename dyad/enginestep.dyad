"short EngineStep component description"
component EngineStep
  cmd = BlockComponents.Sources.Step(height = 200, offset = 0, start_time = 0.5) {^cmd}
  engine = Engine() {^engine}
  load = RotationalComponents.Components.Inertia(J = 1) {^load}
  mounts = RotationalComponents.Components.Fixed() {^mounts}
relations
  initial engine.lag.x = 0
  initial load.phi = 0
  initial load.w = 0
  connect(cmd.y, engine.tau_cmd) {^id5}
  connect(engine.spline, load.spline_a) {^id6}
  connect(engine.support, mounts.spline) {^id7}
metadata {
  "Dyad": {
    "experiments": {},
    "tests": {},
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 1100,
        "rot": 0,
        "layer": "icon",
        "attrs": {}
      }
    ],
    "icons": {"default": "dyad://Dyad/Default.svg"},
    "path": {},
    "doc": {"behavior": true},
    "deprecated": null,
    "panel": {}
  },
  "_links": {
    "cmd": {
      "Dyad": {"placement": {"diagram": {"x1": 140, "x2": 240, "y1": 450, "y2": 550}}}
    },
    "engine": {
      "Dyad": {"placement": {"diagram": {"x1": 360, "x2": 460, "y1": 450, "y2": 550}}}
    },
    "load": {
      "Dyad": {"placement": {"diagram": {"x1": 580, "x2": 680, "y1": 450, "y2": 550}}}
    },
    "mounts": {
      "Dyad": {"placement": {"diagram": {"x1": 360, "x2": 460, "y1": 700, "y2": 800}}}
    },
    "id5": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id6": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id7": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  }
}
end

analysis EngineStepTransient
  extends TransientAnalysis(stop = 3)
  model = EngineStep()
relations
end