"Full throttle on a flat road to verify GradeCar"
component GradeCarFullThrottle
  cmd = BlockComponents.Sources.Constant(k = 150) {^cmd}
  road = BlockComponents.Sources.Constant(k = 0) {^road}
  car = GradeCar() {^car}
relations
  connect(cmd.y, car.tau_cmd) {^id4}
  connect(road.y, car.grade) {^id5}
  initial car.body.mass.s = 0
  initial car.body.mass.v = 0
  initial car.engine.lag.x = 0
metadata {
  "_links": {
    "cmd": {"Dyad": {"placement": {"diagram": {"x1": 20, "x2": 120, "y1": 20, "y2": 120}}}},
    "road": {
      "Dyad": {"placement": {"diagram": {"x1": 30, "x2": 130, "y1": 170, "y2": 270}}}
    },
    "car": {
      "Dyad": {"placement": {"diagram": {"x1": 153, "x2": 253, "y1": 20, "y2": 120}}}
    },
    "id4": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id5": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 140, "y": 111}], "E": 2}], "path": {}}}
  }
}
end