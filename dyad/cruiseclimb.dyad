component CruiseClimb
  controller = MyCar.CruiseController(xd0 = -130) {^controller}
  plant = MyCar.GradeCar() {^plant}
  demand = BlockComponents.Sources.Constant(k = 130) {^demand}
  road = BlockComponents.Sources.Pulse(amplitude = 0.10, offset = 0, start_time = 30, duty_cycle = 1, period = 120) {^road}
relations
  connect(plant.v_kmh, controller.u_m) {^id5}
  connect(controller.y, plant.tau_cmd) {^id6}
  initial plant.body.mass.s = 0
  initial plant.body.mass.v = 130 / 3.6
  initial plant.engine.lag.x = 58.42
  connect(demand.y, controller.u_s) {^id7}
  connect(road.y, plant.grade) {^id8}
metadata {
  "_links": {
    "controller": {
      "Dyad": {"placement": {"diagram": {"x1": 160, "x2": 260, "y1": 110, "y2": 210}}}
    },
