component MapEngine
  pedal = RealInput() {^pedal}
  mdot_bst = RealInput() {^mdot_bst}
  spline = Spline() {^spline}
  support = Spline() {^support}
  p_m = RealOutput() {^p_m}
  mdot_fuel = RealOutput() {^mdot_fuel}
  mdot_co2 = RealOutput() {^mdot_co2}
  air = VehicleSystemsComponents.Vehicle.Engine.AirPath()
  speed = RotationalComponents.Sensors.VelocitySensor()
  torque_map = VehicleSystemsComponents.Vehicle.Engine.CutTorqueMap()
  fuel_map = VehicleSystemsComponents.Vehicle.Engine.CutFuelMap()
  cut_logic = VehicleSystemsComponents.Vehicle.Engine.FuelCutLogic() {^cut_logic}
  co2 = BlockComponents.Math.Gain(k = 3.09)
  torque = RotationalComponents.Sources.TorqueSource() {^torque}
relations
  connect(pedal, air.u_thr) {^id10}
  connect(mdot_bst, air.mdot_bst) {^id11}
  connect(speed.w, air.omega)
  connect(speed.w, torque_map.omega)
  connect(speed.w, fuel_map.omega)
  connect(air.p_m, torque_map.p_m)
  connect(air.p_m, fuel_map.p_m)
  connect(air.p_m, p_m) {^id12}
  connect(torque_map.y, torque.tau) {^id13}
  connect(fuel_map.y, co2.u)
  connect(fuel_map.y, mdot_fuel) {^id14}
  connect(co2.y, mdot_co2) {^id15}
  connect(torque.spline, spline) {^id16}
  connect(speed.spline, spline) {^id17}
  connect(torque.support, support) {^id18}
  connect(pedal, cut_logic.pedal) {^id19}
  connect(speed.w, cut_logic.omega)
  connect(cut_logic.cut, torque_map.cut)
  connect(cut_logic.cut, fuel_map.cut)
